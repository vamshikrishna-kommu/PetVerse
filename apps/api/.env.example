# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ─── Database ────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/petverse

# ─── Auth ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-here
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-chars-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ─── Google OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Cloudinary ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ─── Firebase ────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key-here\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ─── Email ───────────────────────────────────────────────────
SENDGRID_API_KEY=SG.your-sendgrid-api-key
EMAIL_FROM=noreply@petverse.app

# ─── AI Service ──────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_INTERNAL_KEY=your-ai-service-internal-key-minimum-32-characters
GEMINI_API_KEY=your-gemini-api-key

# ─── Redis (Optional Cache / Worker Queue) ───────────────────
REDIS_URL=redis://127.0.0.1:6379

# ─── Payment Provider — India-First: Razorpay (Stripe Fallback)
RAZORPAY_KEY_ID=rzp_test_your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ─── SMS Providers — India-First: MSG91 / 2Factor (Twilio Fallback)
MSG91_API_KEY=your-msg91-api-key
MSG91_SENDER_ID=PETVRS
MSG91_TEMPLATE_ID=your-msg91-template-id
TWOFACTOR_API_KEY=your-2factor-api-key
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+919876543210
AWS_SNS_REGION=ap-south-1

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_MAX=10
