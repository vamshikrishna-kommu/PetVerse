{
  "name": "@petverse/api",
  "version": "1.0.0",
  "private": true,
  "description": "PetVerse Backend API — Node.js + Express + TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests --runInBand",
    "test:coverage": "jest --passWithNoTests --coverage --runInBand",
    "test:watch": "jest --watch",
    "clean": "rimraf dist",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@petverse/shared-constants": "workspace:*",
    "@petverse/shared-types": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "firebase-admin": "^13.0.2",
    "google-auth-library": "^9.14.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "otplib": "^12.0.1",
    "uuid": "^11.0.3",
    "winston": "^3.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.3",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "jest": "^30.4.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
