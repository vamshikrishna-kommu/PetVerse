# ==============================================================================
# PETVERSE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to:
#   - Root: .env (for monorepo scripts / docker)
#   - Backend: apps/api/.env
#   - Frontend: apps/web/.env
#
# Variable Classification:
#   [REQUIRED]         Must be set for the application to boot and operate.
#   [OPTIONAL]         Enables optional third-party integrations (Cloudinary, SendGrid, Firebase).
#   [DEVELOPMENT ONLY] Sensible defaults provided for local developer environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVER & SECURITY (apps/api)
# ------------------------------------------------------------------------------

# [DEVELOPMENT ONLY] Runtime environment ('development' | 'production' | 'test')
NODE_ENV=development

# [OPTIONAL] API Server Port (Default: 3000)
PORT=3000

# [REQUIRED] Web frontend base URL (used for CORS, password reset links, redirect URLs)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (apps/api)
# ------------------------------------------------------------------------------

# [REQUIRED] MongoDB connection URI (must include database name)
MONGODB_URI=mongodb://127.0.0.1:27017/petverse

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & TOKENS (apps/api)
# ------------------------------------------------------------------------------

# [REQUIRED] Secret key for signing Access Tokens (minimum 32 characters)
# Generate with: openssl rand -base64 48
JWT_SECRET=petverse-dev-access-jwt-secret-key-minimum-32-chars-long

# [REQUIRED] Secret key for signing Refresh Tokens (minimum 32 characters)
# Generate with: openssl rand -base64 48
JWT_REFRESH_SECRET=petverse-dev-refresh-jwt-secret-key-minimum-32-chars-long

# [OPTIONAL] Access token lifespan (Default: 15m)
JWT_EXPIRES_IN=15m

# [OPTIONAL] Refresh token lifespan (Default: 7d)
JWT_REFRESH_EXPIRES_IN=7d

# [OPTIONAL] Bcrypt password hashing salt rounds (Default: 12)
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 4. RATE LIMITING (apps/api)
# ------------------------------------------------------------------------------

# [OPTIONAL] Max requests per 15-minute window for standard API routes (Default: 100)
RATE_LIMIT_GLOBAL_MAX=100

# [OPTIONAL] Max requests per 15-minute window for sensitive auth routes (Default: 10)
RATE_LIMIT_AUTH_MAX=10

# ------------------------------------------------------------------------------
# 5. THIRD-PARTY INTEGRATIONS (apps/api)
# ------------------------------------------------------------------------------

# [OPTIONAL] Google OAuth 2.0 Credentials (for backend verification)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# [OPTIONAL] Cloudinary (for pet avatars, vaccination cards, medical records upload)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# [OPTIONAL] Firebase Admin SDK (for backend push notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key-here\n-----END PRIVATE KEY-----"

# [OPTIONAL] SendGrid / Email Delivery
SENDGRID_API_KEY=SG.your-sendgrid-api-key
EMAIL_FROM=noreply@petverse.app

# [OPTIONAL] SMS Provider — India-first: MSG91 (preferred), Twilio (international fallback)
# --- MSG91 (India's most popular transactional SMS gateway) ---
MSG91_API_KEY=your-msg91-api-key
MSG91_SENDER_ID=PETVRSE
MSG91_TEMPLATE_ID=your-msg91-template-id
# --- 2Factor OTP (alternative India SMS provider) ---
TWOFACTOR_API_KEY=your-2factor-api-key
# --- Twilio (international fallback) ---
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+919876543210
# --- AWS SNS (India region) ---
AWS_SNS_REGION=ap-south-1

# [OPTIONAL] Redis Connection URI (Cache & Worker Queue)
REDIS_URL=redis://127.0.0.1:6379

# [OPTIONAL] Google Gemini AI API Key (direct fallback if AI microservice is not deployed)
GEMINI_API_KEY=your-gemini-api-key

# [OPTIONAL] Razorpay Payment Gateway — INDIA-FIRST primary payment provider
# Dashboard: https://dashboard.razorpay.com/ | Supports UPI, Cards, Net Banking, Wallets, EMI
RAZORPAY_KEY_ID=rzp_test_your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# [OPTIONAL] Stripe Payment Gateway — International fallback (for non-India payments)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# [OPTIONAL] PetVerse AI Microservice (FastAPI / PyTorch service)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_INTERNAL_KEY=your-ai-service-internal-key-min-32-characters

# ------------------------------------------------------------------------------
# 6. FRONTEND CLIENT CONFIGURATION (apps/web)
# Note: Vite client-exposed variables MUST begin with VITE_
# ------------------------------------------------------------------------------

# [REQUIRED] Backend API Base URL
VITE_API_BASE_URL=http://localhost:3000/api/v1

# [OPTIONAL] Google OAuth Client ID for web frontend login
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# [OPTIONAL] Google Maps API Key (for nearby clinics and services map view)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# [OPTIONAL] Firebase Web SDK (Client Push Notifications)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-firebase-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_VAPID_KEY=your-firebase-vapid-key
# [OPTIONAL] Razorpay Key ID for frontend Razorpay Checkout SDK (India-first payments)
VITE_RAZORPAY_KEY_ID=rzp_test_your-razorpay-key-id
# [OPTIONAL] Stripe Publishable Key for frontend international payments
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
